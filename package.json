{
  "name": "@lase-launcher/layout-utils",
  "version": "1.0.1",
  "description": "Utility classes and TypeScript definitions for LASE Launcher custom layouts",
  "author": "LASE Launcher",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./types/layout": {
      "types": "./dist/types/layout.d.ts",
      "import": "./dist/types/layout.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --project tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue": "^3.5.13",
    "vue-tsc": "^3.3.5"
  }
}
